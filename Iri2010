<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Word Detective — Unit 1</title>
<style>
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at top,#26345d,#0b0f1d 60%);color:#f7f8ff;font-family:system-ui,-apple-system,Segoe UI,sans-serif}
.wrap{max-width:950px;margin:auto;padding:28px 18px 50px}.top{display:flex;justify-content:space-between;align-items:center}.logo{font-size:24px;font-weight:900}.tag{padding:7px 12px;border:1px solid #ffffff25;border-radius:99px;color:#c8d0ee;font-size:13px}
.hero{text-align:center;padding:45px 0 25px}.hero h1{font-size:clamp(40px,7vw,64px);margin:0 0 8px;letter-spacing:-2px}.hero p{color:#aeb8d8;font-size:17px}
.panel{background:#12182bee;border:1px solid #ffffff18;border-radius:24px;padding:24px;box-shadow:0 20px 70px #0008}.modes{display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap}.modes button{border:1px solid #ffffff20;background:#ffffff0c;color:#e9edff;padding:10px 14px;border-radius:99px;cursor:pointer}.modes .active{background:#8fdcff;color:#08101b;font-weight:800}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.stat{background:#ffffff08;border-radius:15px;padding:12px;text-align:center}.stat b{display:block;font-size:24px}.stat span{font-size:11px;color:#9fa9ca}.progress{height:8px;background:#ffffff0c;border-radius:99px;margin:18px 0 24px;overflow:hidden}.bar{height:100%;width:0;background:#8fdcff}
.case{font-size:12px;letter-spacing:1.5px;color:#8fdcff;font-weight:900}.question{font-size:clamp(21px,4vw,30px);line-height:1.4;font-weight:750;margin:10px 0 22px}.choices{display:grid;grid-template-columns:1fr 1fr;gap:12px}.choice{background:#1b2340;color:#fff;border:1px solid #ffffff18;border-radius:15px;padding:16px;text-align:left;cursor:pointer;font-size:15px;transition:.15s}.choice:hover{transform:translateY(-2px);background:#253052}.choice.correct{background:#123d32;border-color:#55e0b2}.choice.wrong{background:#49212d;border-color:#ff7891}.feedback{min-height:45px;padding-top:14px;font-weight:800}.controls{display:flex;justify-content:space-between;margin-top:10px;gap:10px}.action{border:0;border-radius:13px;padding:12px 18px;font-weight:900;cursor:pointer;background:#8fdcff;color:#08101b}.secondary{background:#ffffff10;color:#eef1ff;border:1px solid #ffffff18}.end{display:none;text-align:center;padding:25px}.big{font-size:70px;font-weight:950;margin:8px}.muted{color:#aeb8d8}
@media(max-width:650px){.choices{grid-template-columns:1fr}.panel{padding:18px}}
</style></head>
<body><div class="wrap">
<div class="top"><div class="logo">🕵️ Word Detective</div><div class="tag">Unit 1 • Digital Information</div></div>
<div class="hero"><h1>Solve the Vocabulary Case.</h1><p>Find the word. Build your streak. Close every case.</p></div>
<div class="panel">
<div class="modes"><button id="dm" class="active" onclick="setMode('def')">Definition → Word</button><button id="wm" onclick="setMode('word')">Word → Definition</button></div>
<div class="stats"><div class="stat"><b id="score">0</b><span>SCORE</span></div><div class="stat"><b id="streak">0</b><span>STREAK 🔥</span></div><div class="stat"><b id="num">1</b><span>CASE</span></div></div>
<div class="progress"><div class="bar" id="bar"></div></div>
<div id="game"><div class="case">🔎 CASE FILE</div><div class="question" id="q"></div><div class="choices" id="choices"></div><div class="feedback" id="fb"></div><div class="controls"><button class="action secondary" onclick="restart()">↻ Restart</button><button class="action" id="next" onclick="nextQ()" disabled>Next Case →</button></div></div>
<div class="end" id="end"><div class="case">🎉 CASE CLOSED</div><div class="big" id="final">0</div><h2>Great detective work!</h2><p class="muted" id="finalText"></p><button class="action" onclick="restart()">Play Again</button></div>
</div></div>
<script>
const WORDS=[{"word": "Innovation", "defn": "A new or improved idea, device, product, etc, or the development thereof."}, {"word": "Computing Innovation", "defn": "An innovation that includes a computer or program code as an integral part of its functionality"}, {"word": "Binary", "defn": "A way of representing information using only two options"}, {"word": "Bit", "defn": "A contraction of \"Binary Digit\"; the single unit of information in a computer, typically represented as a 0 or 1"}, {"word": "Byte", "defn": "8 bits"}, {"word": "Decimal", "defn": "A way of representing information using ten options"}, {"word": "Overflow Error", "defn": "Error from attempting to represent a number that is too large"}, {"word": "Round-off Error", "defn": "Error from attempting to represent a number that is too precise. The value is rounded."}, {"word": "ASCII", "defn": "American Standard Code for Information Interchange; the universally recognized raw text format that any computer can understand."}, {"word": "Abstraction", "defn": "A simplified representation of something more complex."}, {"word": "Analog Data", "defn": "Data with values that change continuously, or smoothly, over time. Some examples of analog data include music, colors of a painting, or position of a sprinter during a race."}, {"word": "Digital Data", "defn": "Data that changes discretely through a finite set of possible values"}, {"word": "Sampling", "defn": "A process for creating a digital representation of analog data by measuring the analog data at regular intervals called samples."}, {"word": "Lossless Compression", "defn": "A process for reducing the number of bits needed to represent something without losing any information. This process is reversible."}, {"word": "Lossy Compression", "defn": "A process for reducing the number of bits needed to represent something in which some information is lost or thrown away. This process is not reversible."}, {"word": "Creative Commons", "defn": "A collection of public copyright licenses that enable the free distribution of an otherwise copyrighted work, used when an author wants to give people the right to share, use, and build upon a work that they have created"}, {"word": "Intellectual Property", "defn": "A work or invention that is the result of creativity, such as a piece of writing or a design, to which one has rights and for which one may apply for a patent, copyright, trademark, etc."}, {"word": "Pixel", "defn": "Short for “picture element”. It is the fundamental unit of a digital image, typically a tiny square or dot which contains a single point of color of a larger image."}, {"word": "Metadata", "defn": "Data that describes other data."}, {"word": "Kilobyte (KB)", "defn": "1024 Bytes"}, {"word": "Megabyte (MB)", "defn": "1024 Kilobytes"}, {"word": "Gigabyte (GB)", "defn": "1024 Megabytes"}, {"word": "Terabyte (TB)", "defn": "1024 Gigabytes"}, {"word": "Petabyte (PB)", "defn": "1024 Terabytes"}];
let mode='def',order=[],i=0,score=0,streak=0,answered=false;
const shuffle=a=>[...a].sort(()=>Math.random()-.5);
function restart(){order=shuffle(WORDS);i=0;score=0;streak=0;document.getElementById('game').style.display='block';document.getElementById('end').style.display='none';render()}
function setMode(m){mode=m;document.getElementById('dm').classList.toggle('active',m==='def');document.getElementById('wm').classList.toggle('active',m==='word');restart()}
function render(){answered=false;let x=order[i];document.getElementById('score').textContent=score;document.getElementById('streak').textContent=streak;document.getElementById('num').textContent=(i+1)+'/'+order.length;document.getElementById('bar').style.width=(i/order.length*100)+'%';document.getElementById('next').disabled=true;document.getElementById('fb').textContent='';document.getElementById('q').textContent=mode==='def'?x.defn:x.word;
let opts=shuffle([x,...shuffle(WORDS.filter(y=>y.word!==x.word)).slice(0,3)]),box=document.getElementById('choices');box.innerHTML='';
opts.forEach(o=>{let b=document.createElement('button');b.className='choice';b.textContent=mode==='def'?o.word:o.defn;b.onclick=()=>choose(b,o.word===x.word);box.appendChild(b)})}
function choose(btn,ok){if(answered)return;answered=true;document.querySelectorAll('.choice').forEach(b=>b.disabled=true);let x=order[i];
if(ok){let pts=10+Math.min(streak+1,5)*2;score+=pts;streak++;btn.classList.add('correct');document.getElementById('fb').textContent='✅ Case solved! +'+pts+' points'}else{streak=0;btn.classList.add('wrong');document.querySelectorAll('.choice').forEach(b=>{if(b.textContent===(mode==='def'?x.word:x.defn))b.classList.add('correct')});document.getElementById('fb').textContent='❌ Not quite. Answer: '+x.word}
document.getElementById('score').textContent=score;document.getElementById('streak').textContent=streak;document.getElementById('next').disabled=false}
function nextQ(){if(!answered)return;i++;if(i>=order.length){document.getElementById('game').style.display='none';document.getElementById('end').style.display='block';document.getElementById('final').textContent=score;document.getElementById('finalText').textContent='You solved all '+order.length+' Unit 1 vocabulary cases.'}else render()}
restart();
</script></body></html>
